{
  "name": "echo",
  "productName": "Echo",
  "version": "1.1.0",
  "author": "Aamir Azmi",
  "description": "Voice dictation for Windows: hold a hotkey, speak, and the transcript is typed into the focused app.",
  "license": "UNLICENSED",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "node scripts/build-bundles.cjs --dev && electron .",
    "dev": "node scripts/dev.cjs",
    "verify:release-assets": "node scripts/verify-release-assets.cjs",
    "package": "npm run build:bundles && electron-builder --config electron-builder.config.cjs --win dir --x64 --publish never",
    "make": "npm run make:nsis",
    "publish": "npm run publish:nsis",
    "build:bundles": "node scripts/build-bundles.cjs",
    "make:nsis": "node scripts/verify-release-assets.cjs --require-signing && npm run build:bundles && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "publish:nsis": "node scripts/verify-release-assets.cjs --require-signing && npm run build:bundles && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish always",
    "release": "node scripts/release.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node ./node_modules/eslint/bin/eslint.js src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.2.10",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.105.1",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "autoprefixer": "^10.4.20",
    "electron": "^41.7.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9.16.0",
    "postcss": "^8.4.47",
    "tailwindcss": "3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3",
    "vite": "^6.4.1",
    "vitest": "^3.1.1"
  }
}
